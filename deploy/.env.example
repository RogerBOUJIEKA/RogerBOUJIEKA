# ─── Domaines (les DNS doivent pointer vers ce serveur avant le premier démarrage) ───
SITE_DOMAIN=kle.example
API_DOMAIN=api.kle.example
ADMIN_DOMAIN=equipe.kle.example
# Numéro WhatsApp affiché sur le site (format international sans « + »), facultatif.
WHATSAPP_CONTACT_NUMBER=

# ─── Phase de lancement ───
# waitlist : phase 0 (page d'attente + back-office). v1 : application complète.
LAUNCH_PHASE=waitlist

# ─── Secrets : générer chacun avec `openssl rand -base64 48` ───
POSTGRES_PASSWORD=
JWT_SECRET=
APP_SECRET=
OTP_DEV_ECHO=false
JOBS_ENABLED=true

# ─── Messages ───
# Phase 0 : « log » suffit (les codes de connexion de l'équipe s'affichent dans
# `docker compose logs api`). V1 : « live » avec WhatsApp Business (Cloud API).
NOTIFY_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=kle_otp

# ─── Paiements Mobile Money (obligatoire en V1) ───
PAYMENT_PROVIDER=fake
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_WEBHOOK_HASH=

# ─── Fichiers (obligatoire en V1 : s3) ───
# Pièces d'identité dans un bucket PRIVÉ et chiffré, photos dans un bucket public.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Vidéos ───
VIDEO_PROVIDER=local
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
