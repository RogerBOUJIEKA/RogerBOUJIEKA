# API Klé — copier en .env pour le développement local.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://kle:kle@localhost:5432/kle
REDIS_URL=redis://localhost:6379
PUBLIC_API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Secrets : en production, générer avec `openssl rand -base64 48`.
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
APP_SECRET=dev-only-app-secret-change-me-dev-only-app

# Développement : le code OTP est renvoyé dans la réponse et affiché dans les journaux.
OTP_DEV_ECHO=true
JOBS_ENABLED=true

# Paiements Mobile Money : fake (simulateur) ou notchpay.
PAYMENT_PROVIDER=fake
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_WEBHOOK_HASH=

# Messages : log (journaux) ou live (WhatsApp Business Cloud API).
NOTIFY_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=kle_otp

# Fichiers : local (disque) ou s3 (R2, Scaleway, OVH…). Pièces d'identité dans le bucket privé.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Vidéos : local ou cloudflare (Cloudflare Stream).
VIDEO_PROVIDER=local
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# Création du premier administrateur par `pnpm db:seed` (format international).
SEED_ADMIN_PHONE=
